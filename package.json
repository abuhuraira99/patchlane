{
  "name": "patchlane",
  "version": "1.0.0",
  "description": "A security check-up for APIs and the AI agents that call them: OWASP API Top 10 review of OpenAPI specs, server headers, JWTs, release diffs and MCP tool definitions, with fix code for five frameworks. Runs in the browser, the terminal and GitHub Actions.",
  "type": "module",
  "license": "MIT",
  "author": "Abu Huraira",
  "bin": {
    "patchlane": "cli/dist/patchlane.mjs"
  },
  "files": [
    "cli/dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:cli && node scripts/postbuild.mjs",
    "build:cli": "esbuild cli/patchlane.ts --bundle --platform=node --format=esm --target=node18 --outfile=cli/dist/patchlane.mjs --banner:js=\"#!/usr/bin/env node\"",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:site": "vite build && node scripts/postbuild.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name patchlane --branch main",
    "check": "node cli/dist/patchlane.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  },
  "keywords": [
    "api-security",
    "owasp",
    "openapi",
    "swagger",
    "jwt",
    "cors",
    "mcp",
    "llm-security",
    "sarif",
    "github-action",
    "devsecops",
    "security-testing"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/abuhuraira99/patchlane.git"
  },
  "homepage": "https://patchlane.pages.dev",
  "bugs": {
    "url": "https://github.com/abuhuraira99/patchlane/issues"
  }
}
